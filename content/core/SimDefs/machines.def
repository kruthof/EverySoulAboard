# =============================================================================
# machines.def — the machine table (one row per DeviceKind) + radiator reject
# =============================================================================
# These are the SHIPPED DEFAULTS, verbatim from SimDefs.CreateDefault (which
# mirrors Sim.Core/Entities/MachineDefs.cs). Present so designers can retune in
# place; because every value equals the compiled default, this file changes
# nothing and the defs checksum stays identical to the no-file default.
# Delete or omit any row/line to fall back to the compiled default.
#
# Columns (whitespace-aligned, keyed by DeviceKind NAME):
#   NAME  draw  gen  tier  blocks  heat  wear  maint  fail
#     draw    kW consumed while wanting power
#     gen     kW produced
#     tier    brownout shed order: Comfort | Industry | Defense | LifeSupport
#     blocks  true if the machine occupies its tile (side-view: all false)
#     heat    kW waste heat into the room while operating
#     wear    Condition lost per operating hour at nominal temperature
#     maint   wants a maintenance job below this Condition; 0 = NEVER serviced (the opt-out)
#     fail    inoperative below this Condition  (must be <= maint, UNLESS maint is 0)

[machines]
radiator_reject_kw = 5      # kW a powered, condition-scaled radiator rejects
heater_output_kw   = 5      # kW a powered, condition-scaled heater PUSHES IN (M3-10; the mirror of
                            # the line above, capped by thermal.def's heater_ceiling_k)

#                 draw   gen  tier          blocks  heat   wear    maint  fail
Door            0.1    0    Defense       false   0.05   0.002   0.3    0.05
AirVent         0.5    0    LifeSupport   false   0.2    0.010   0.4    0.10
Scrubber        0.4    0    LifeSupport   false   0.4    0.012   0.4    0.10
Ladder          0      0    Comfort       false   0      0       0      0
Terminal        0.1    0    Defense       false   0.1    0.001   0.2    0.02
SolarWing       0      6    Comfort       false   0      0.004   0.4    0.10
Battery         0      0    Comfort       false   0.1    0.002   0.3    0.05
Conduit         0      0    Comfort       false   0      0       0      0
Light           0.15   0    Comfort       false   0.15   0.001   0.2    0.02
GrowBed         0.6    0    Industry      false   0.5    0.008   0.4    0.10
WaterTank       0      0    Comfort       false   0      0.001   0.2    0.02
Pipe            0      0    Comfort       false   0      0       0      0
Reclaimer       0.8    0    LifeSupport   false   0.6    0.012   0.4    0.10
Fabricator      3      0    Industry      false   2.5    0.020   0.4    0.10
MachineShop     2      0    Industry      false   1.6    0.020   0.4    0.10
SalvageRecycler 1.5    0    Industry      false   1.2    0.018   0.4    0.10
Radiator        0.2    0    LifeSupport   false   0      0.006   0.4    0.10
# Furniture (inert; placed by the Sim.Gen RoomDresser)
Bed             0      0    Comfort       false   0      0       0      0
Table           0      0    Comfort       false   0      0       0      0
Chair           0      0    Comfort       false   0      0       0      0
MedBed          0      0    Comfort       false   0      0       0      0
MedCabinet      0      0    Comfort       false   0      0       0      0
Locker          0      0    Comfort       false   0      0       0      0
Desk            0      0    Comfort       false   0      0       0      0
PlantPot        0      0    Comfort       false   0      0       0      0
Telescope       0.4    0    Industry      false   0.2    0.004   0.4    0.1
# Water chain (E0-7): LifeSupport tier on purpose — on a ship whose only water source is ice,
# the melter is the last thing a brownout may shed, not the first. The 0.4 kW draw is measured,
# not physical — see MachineDefs.cs (at 1.0 kW the melter cost 28% of the slice's food and
# inflated A1 by ~11 pp of pure brownout slowdown).
IceMelter       0.4    0    LifeSupport   false   0.4    0.012   0.4    0.10
# The wreck start (W3): a cryogenic sleeper capsule. INERT in the sim — no system reads the kind.
# LifeSupport tier because a pod IS life support for whoever is inside it, and the tier is served
# all-or-nothing, so twelve pods share a bucket with the vents: budget generation before adding pods
# to a marginal ship. draw/heat are deliberately the smallest non-trivial pair in the table (a draw
# is a brownout tax, not a load — ECONOMY.md §1.2), and the 0.15 kW of waste heat is what holds the
# wreck's cryo bay above hypothermia_c on a ship with no heater device. wear is the lowest non-zero
# rate here: a dormant vessel asks nothing of the crew for ~29 sim-days.
#
# maint 0 IS THE OPT-OUT, NOT A THRESHOLD — this is the only row in the table that is both never
# serviced and able to fail. Repairing a pod is a PLAYER act (the thaw), not a standing rule. At
# maint 0.30 the wreck's whole opening stock (1 Parts, 2 Seals) was spent unattended on the four
# DEAD sleepers' capsules inside one sim-day — measured, first Maintain job at tick 201 — because
# they are the lowest-Condition devices on the ship and MaintenanceSystem recruits neediest first.
# fail 0.10 still stands: below it a pod is inoperative and paints Broken, which is how a wrecked
# capsule reads as dead. NOTE the `fail <= maint` column rule above does NOT apply to a maint = 0
# row, and DefsParser exempts it by name — see DefsParserTests.
CryoPod         0.2    0    LifeSupport   false   0.15   0.001   0      0.10
# M3-10: THE HEATER — the first device in the game that raises a room's temperature on purpose, and
# the answer to a compartment that refuses all work because it is below needs.def hypothermia_c.
# heat is 0 ON PURPOSE, exactly as the Radiator's row is: this column is WASTE heat, emitted
# unconditionally and NOT condition-scaled, and a heater's heat is its PRODUCT. The output rides
# heater_output_kw above, which ThermalSystem scales by Device.EffectiveRate (a worn heater is a
# weak heater) and caps at thermal.def's heater_ceiling_k.
# LifeSupport tier is a SHIPPED INTERIM and the question is OPEN ON THE OWNER. This comment used to
# say Industry was "already shed at boot and still shed on day 10, so an Industry heater would never
# once be powered". THAT WAS FALSE: the tier walk decides against generation PLUS battery charge
# (PowerSystem.cs:246-247), so the ship runs a brownout sawtooth and a single sample reads one phase
# of it. Re-measured over ten sim-days sampling every 10 sim-minutes, the three WIRED Industry
# machines run 36.1% of the time (the other four are NetworkId 0 — never cabled, which is not a tier
# fact at all). An Industry heater would be WEAK, not inert, and choosing weak-and-safe over
# always-on-and-dangerous is a design call. See MachineDefs.cs and MECHANICS.md 13.36.
# The cost of LifeSupport, measured by DRIVING N heaters on a copy of the wreck (3 sim-days each,
# watching the wired deck-0 doors and machineshop_1): N=2 costs no tier anything; N=3 sheds DEFENSE
# (doors 100% -> 84.7%); N=4 sheds LIFE SUPPORT itself (95.7% -> 81.1%). Every arm from N=1 pays in
# Industry and Comfort uptime (36% -> ~16%) — a heater is bought with the benches' duty cycle.
# wear/maint/fail are the Radiator's: same class of plant, same standing maintenance terms.
Heater          1.0    0    LifeSupport   false   0      0.006   0.4    0.10
