# =============================================================================
# citizen.def — citizen movement cadence (CitizenSystem)
# =============================================================================
# Shipped DEFAULTS, verbatim from SimDefs.CreateDefault. Every value equals the
# compiled default, so this file changes nothing and leaves the defs checksum
# identical.
# Delete or omit any line to fall back to the compiled default.

[citizen]
ticks_per_tile             = 10   # ticks to cross one tile (10 = 1 tile/s at 10 Hz; E0-2 L1 retune, was 5)
idle_ticks_between_wanders = 30   # idle ticks before an idle citizen wanders
wander_radius_tiles        = 8    # E0-1: idle-wander target drawn within this Chebyshev radius
                                  #       IN X AND Y ONLY (local dispersal near work; UNTUNED, pending A1)
                                  #       This does NOT scope Z and no value of it will: an idle
                                  #       wander is pinned to the crew member's own deck, as a rule
                                  #       in code, not a setting (deck-confined wander, 2026-07-25).
