# =============================================================================
# deconstruct.def — strip costs and yields (DeconstructSystem, E0-5)
# =============================================================================
# Shipped DEFAULTS, verbatim from SimDefs.CreateDefault. Every value equals the
# compiled default, so this file changes nothing and leaves the defs checksum
# identical to a run without it. Delete or omit any line to fall back to the
# compiled default.
#
# Deconstruct is BUILD'S INVERSE and deliberately LOSSY: a stripped wall returns
# floor(build.wall_material x wall_recovery) = floor(2 x 0.5) = 1 Regolith, half
# of what raising it consumed. Regolith re-enters the ladder at the TOP
# (SalvageRecycler consumes Regolith to make Scrap), so tearing a wall down is
# never better than digging one out. Yielding Scrap instead would skip a
# conversion hop and invert that; revisit at E0-6, when the graph inverts.
#
# The pressure hull is never strippable (a wall adjacent to vacuum or the map
# edge) — that is a code rule in DeconstructSystem.IsPressureHull, not a tunable.
#
# A stripped DEVICE returns floor(device_parts x Condition) Parts — the only place
# outside MachineWearSystem where Device.Condition changes an outcome. Parts feed
# the ship's one never-ending sink (an overhaul consumes ONE Part), so 2 Parts is
# exactly two overhauls: stripping a machine in good repair pays to keep two others
# alive, and a wreck below Condition 0.5 is worth nothing at all.
#
# THE ROUND TRIP IS LOSSY, AND IT IS ONLY LOSSY BECAUSE PLACING COSTS (E0-5 WP-3):
# device_parts is read against [build] device_place_cost = 3 PARTS, in the same
# currency, so the best possible cycle — place a machine, strip it pristine — is
# 3 Parts out and 2 back. Raising device_parts to 3 or lowering device_place_cost
# to 2 turns furniture into a Parts printer feeding maintenance forever. The two
# numbers are a PAIR; retune them together or not at all.
#
# WHICH DEVICES: any device EXCEPT a Door. Doors are BuildSystem's output and their
# inverse is build-cancel; two owners for one object's lifetime is the bug. Life
# support is deliberately INCLUDED — stripping the scrubber to make rent is the
# game, and E0-2's SafetySystem already handles the consequence. That is a code
# rule in DeconstructSystem.CanDesignate, not a tunable.

[deconstruct]
wall_recovery     = 0.5   # fraction of build.wall_material a stripped wall returns (floored)
wall_work_ticks   = 1200  # work ticks to tear a Wall down (120 s; half build's 2400)
max_staged        = 64    # cap on concurrent pending deconstruct designations (queue guard)
device_parts      = 2     # base Parts a stripped device returns, before floor(x Condition)
device_work_ticks = 900   # work ticks to strip a device (90 s; between maintenance and a wall)
