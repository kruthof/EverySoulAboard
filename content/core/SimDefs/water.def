# =============================================================================
# water.def — fluid network / reclaimer scalars (WaterSystem)
# =============================================================================
# Shipped DEFAULTS, verbatim from SimDefs.CreateDefault. Every value equals the
# compiled default, so this file changes nothing and leaves the defs checksum
# identical. The 0.5 s pass Dt and the 1e-4 draw epsilon are structural and NOT
# tunable here.
# Delete or omit any line to fall back to the compiled default.
#
# tank_capacity_liters is also read outside the tick by ShipMetrics (sidebar
# tank fill) and Sim.Glyph's water-lens fill band — all via sim.Defs.Water.

[water]
tank_capacity_liters        = 500      # L — per-tank capacity
reclaimer_liters_per_second = 0.05     # L/s reclaimer output rate
reclaim_efficiency          = 0.93     # recovered fraction (ISS-class 93% closure)
makeup_floor_liters         = 20       # L — self-throttling greywater floor (B-2): tops the
                                       #     pool up to this level only when it would fall
                                       #     below it, replacing exactly the water the lossy
                                       #     loop destroys and nothing more (never inflates).
                                       #     E0-7: SUPPRESSED on any ship that owns an IceMelter —
                                       #     the stand-in steps aside for the real chain. Set 0 to
                                       #     disable it everywhere.
ice_liters_per_unit         = 25       # L of potable water per unit of ItemKind.Ice melted
melter_buffer_liters        = 100      # L — a melter's own meltwater buffer (its StoredLiters);
                                       #     WaterSystem drains it onto the melter's fluid network,
                                       #     and a melter that cannot hold another batch stops
                                       #     recruiting instead of boiling the ice away
