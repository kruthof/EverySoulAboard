<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless glyph host for the shipping Perilune. Boots the SAME sim Unity's
       Bootstrap.BuildAuthoredSim boots (authored plan + DeviceLayout + system
       stack + fog + MOSS bindings), then projects it through Sim.Glyph. Compiles
       the engine-free sim assemblies by source glob, exactly as ScenarioRunner
       does; Unity remains the source of truth for shipping builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PeriluneTui</AssemblyName>
    <RootNamespace>Moonbase.Tui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../sim/Sim.Core/**/*.cs" />
    <Compile Include="../../sim/Sim.Dsl/**/*.cs" />
    <Compile Include="../../sim/Sim.Gen/**/*.cs" />
    <Compile Include="../../sim/Sim.Glyph/**/*.cs" />
  </ItemGroup>

</Project>
