<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless test host for the engine-free assemblies (Sim.Core/Sim.Dsl/Sim.Gen/
       Sim.Glyph). Compiles the same sources ScenarioRunner does, plus every test
       file in this directory. Runs with `~/.dotnet/dotnet test` — no Unity. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Perilune.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../sim/Sim.Core/**/*.cs" />
    <Compile Include="../../sim/Sim.Dsl/**/*.cs" />
    <Compile Include="../../sim/Sim.Gen/**/*.cs" />
    <Compile Include="../../sim/Sim.Glyph/**/*.cs" />
    <Compile Include="../../sim/Sim.Llm/**/*.cs" />
    <Compile Include="../../sim/Sim.Content/**/*.cs" />
    <!-- Share the PeriluneTui host + dump renderer so the golden fixtures assert on the
         exact code path the CLI prints. Explicit allowlist (not a glob): the interactive
         client's Console/raw-mode files (AnsiTerminal, GameLoop, KeyDecoder, …) must NOT
         leak into the headless test host — add a file here only when tests need it. -->
    <Compile Include="../../hosts/tui/SimHost.cs" />
    <Compile Include="../../hosts/tui/DeviceLayoutFile.cs" />
    <Compile Include="../../hosts/tui/DumpMode.cs" />
    <!-- A4: the PURE interactive-client pieces only. These have zero Console/raw-mode
         dependency (no ITerminal/AnsiTerminal/GameLoop) so they compile headless and are
         golden/unit-testable. Never add AnsiTerminal.cs / GameLoop.cs here. -->
    <Compile Include="../../hosts/tui/Terminal/KeyDecoder.cs" />
    <Compile Include="../../hosts/tui/Terminal/AnsiPaint.cs" />
    <Compile Include="../../hosts/tui/Ui/InspectorModel.cs" />
    <!-- E0-4 WP-5: the pure pending-stockpile-filter helpers. GameLoop owns Console/raw-mode and is
         deliberately absent from this host, so the filter logic lives here to be testable at all. -->
    <Compile Include="../../hosts/tui/Ui/StockFilterModel.cs" />
    <Compile Include="../../hosts/tui/Ui/ScreenComposer.cs" />
    <!-- A6: the web skin's PURE wire serializer only. WebHost/Program touch sockets and
         threads and must NOT leak into the headless test host — add a file here only when a
         test needs the pure logic. GameSession is pure apart from its (unstarted) sim thread:
         WebCommand.Parse and the message-building helpers are unit-tested directly. -->
    <Compile Include="../../hosts/web/WireFormat.cs" />
    <!-- console-retirement WP-3: the `zones` channel, a sibling PARTIAL of WireFormat (the spine file
         itself takes a one-token diff). This list is an explicit allowlist by design, so a new
         WireFormat*.cs must be added here by hand — SurfaceBoundaryTests globs the directory from
         DISK and would happily report a channel this project cannot even compile. -->
    <Compile Include="../../hosts/web/WireFormat.Zones.cs" />
    <!-- the `marks` channel: another sibling partial, and this time WireFormat.cs takes NO diff at
         all — WP-3 already paid the one-token `partial`. Same hand-added rule as above. -->
    <Compile Include="../../hosts/web/WireFormat.Marks.cs" />
    <!-- E0-8: the `ledger` channel — a third sibling partial, same hand-added rule as above. Without
         this line GameSession.cs does not compile here at all, which is the loud version of the
         failure the comment above warns about. -->
    <Compile Include="../../hosts/web/WireFormat.Ledger.cs" />
    <!-- the `items` channel: a fourth sibling partial, WireFormat.cs again taking NO diff. Same
         hand-added rule as above — and the rule bit immediately: leaving this line out failed the
         build with `the type name 'ItemCell' does not exist in the type 'WireFormat'`, which is
         exactly the loud failure the comment above promises. -->
    <Compile Include="../../hosts/web/WireFormat.Items.cs" />
    <!-- the `devices` channel (PLURAL — per-device wear, not the one-shot `device` terminal reply):
         a fifth sibling partial, WireFormat.cs again taking NO diff. Same hand-added rule, and it bit
         again exactly as promised — leaving this line out failed with `the type name 'DeviceCell'
         does not exist in the type 'WireFormat'`. -->
    <Compile Include="../../hosts/web/WireFormat.Devices.cs" />
    <!-- the `blocked` channel (WHY an order the player painted is doing nothing): a SIXTH sibling
         partial, WireFormat.cs again taking NO diff. Same hand-added rule, and it bit a THIRD time
         exactly as the two comments above promise — leaving this line out failed with `the type name
         'BlockedCell' does not exist in the type 'WireFormat'`. -->
    <Compile Include="../../hosts/web/WireFormat.Blocked.cs" />
    <!-- E0-8: the pure ShipMetrics honesty audit behind the `ledger` verb (Program.cs owns the IO).
         Tested directly so "an independent derivation, not the metric's own expression" is pinned. -->
    <Compile Include="../../hosts/scenario/LedgerHarness.cs" />
    <Compile Include="../../hosts/web/GameSession.cs" />
    <!-- L6: the conversation runtime (sockets-free) — GameSession delegates talk/say/bye to it,
         so the headless host needs it to compile and to drive the offline dialogue tests. -->
    <Compile Include="../../hosts/web/ConversationHub.cs" />
    <!-- W4: the pure persona→JSON renderer behind `dump-personas` (Program.cs owns the IO). -->
    <Compile Include="../../hosts/scenario/PersonaDump.cs" />
    <!-- E0-5 WP-4: the pure occupancy strip-selection helper (Program.cs owns the IO/flag).
         Tested directly so "designates exactly N workable non-hull walls, canonical order" is pinned. -->
    <Compile Include="../../hosts/scenario/StripHarness.cs" />
    <!-- E0-4 WP-3: the pure occupancy stockpile-selection helper (Program.cs owns the IO/flag).
         Tested directly so "designates the same N walkable tiles on two runs" is pinned. -->
    <Compile Include="../../hosts/scenario/StockpileHarness.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

</Project>
